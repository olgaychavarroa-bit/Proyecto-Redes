POSTGRES_USER=iot_admin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=iot_hospital
POSTGRES_HOST=iot-postgres
POSTGRES_PORT=5432

MQTT_HOST=iot-mosquitto
MQTT_PORT=8883
MQTT_USER=ingestor
MQTT_PASSWORD=change_me
MQTT_TOPIC=hospital/+/telemetry

BACKEND_PORT=5000
WAIT_TIMEOUT=120
WAIT_INTERVAL=2
JWT_SECRET_KEY=change_me_with_a_long_random_secret
JWT_ACCESS_MINUTES=30
JWT_ISSUER=iot-hospital-backend
JWT_AUDIENCE=iot-hospital-admin
MQTT_TLS_ENABLED=true
MQTT_CA_CERT=/app/certs/ca.crt

# Usuario local para leer secretos de simuladores
LOCAL_UID=1000
LOCAL_GID=1000

# Política de retención de telemetría
TELEMETRY_RETENTION_ENABLED=true
TELEMETRY_RETENTION_DAYS=30
TELEMETRY_RETENTION_INTERVAL_SECONDS=86400
